{
  "_comment": "Merge the parts you want into ~/.claude/settings.json (or a project's .claude/settings.json). Option A uses the hook; option B is rules only.",
  "optionA_hooks": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "python3 /ABSOLUTE/PATH/TO/claude/hooks/envh_ask.py",
              "timeout": 10
            }
          ]
        }
      ]
    }
  },
  "optionB_rules_only": {
    "permissions": {
      "ask": [
        "Bash(envh session start *)",
        "Bash(envh preset propose *)",
        "Bash(envh import *)"
      ],
      "deny": [
        "Bash(sudo *)",
        "Bash(su *)",
        "Read(**/.env)",
        "Read(**/.env.*)"
      ]
    }
  }
}
